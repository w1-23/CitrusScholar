[Unit]
Description=CitrusScholar 8043 Web
Wants=citrusscholar-8043-merged-worker.service
After=citrusscholar-8043-merged-worker.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
WorkingDirectory=/home/WZQ/citrusscholar/releases/8043-merged-20261124.c379e1d
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=LANG=C.UTF-8
ExecStart=/usr/bin/python3.12 -BI launch.py web
Restart=always
RestartSec=5s
KillMode=mixed
TimeoutStopSec=45s
LimitCORE=0
LimitNOFILE=65536
UMask=0077

[Install]
WantedBy=default.target
