  "components": {
    "schemas": {
      "Edit": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "overrides": {
            "patternProperties": {
              "^[a-zA-Z0-9_:.-]{1,160}$": {
                "$ref": "#/components/schemas/Override"
              }
            },
            "type": "object",
            "maxProperties": 64,
            "minProperties": 1,
            "title": "Overrides"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "overrides"
        ],
        "title": "Edit"
      },
      "Export": {
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "png",
              "svg",
              "pdf"
            ],
            "title": "Format"
          },
          "width_mm": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 400.0,
                "minimum": 15.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Width Mm"
          },
          "height_mm": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 400.0,
                "minimum": 15.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Height Mm"
          },
          "dpi": {
            "type": "integer",
            "maximum": 450.0,
            "minimum": 72.0,
            "title": "Dpi",
            "default": 150
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "format"
        ],
        "title": "Export"
      },
      "FigureDocument": {
        "properties": {
          "renderer": {
            "$ref": "#/components/schemas/Renderer"
          },
          "editability": {
            "type": "string",
            "enum": [
              "semantic",
              "partial",
              "layout_only",
              "preview_only"
            ],
            "title": "Editability"
          },
          "panels": {
            "items": {
              "$ref": "#/components/schemas/Panel"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Panels"
          },
          "objects": {
            "items": {
              "$ref": "#/components/schemas/FigureObject"
            },
            "type": "array",
            "maxItems": 1200,
            "title": "Objects"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Limitations"
          },
